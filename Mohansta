import requests, os, sys, time, re, random, string
from cfonts import render
from concurrent.futures import ThreadPoolExecutor

# Neon Matrix Colors
Z = '\033[1;31m' # Red
G = '\033[1;32m' # Green
Y = '\033[1;33m' # Yellow
W = '\033[1;37m' # White
B = '\033[1;34m' # Blue
P = '\033[1;35m' # Purple
C = '\033[1;36m' # Cyan
COLOR_LIST = [G, Y, B, P, C, W, G, C]

accounts = [] 
deleted_count = 0
failed_count = 0
loop = 0

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

def linex():
    print(G + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

def get_random_ua():
    """توليد بصمات أجهزة عشوائية لتخطي الحظر"""
    android_vers = random.randint(9, 14)
    chrome_vers = random.randint(100, 125)
    build = random.randint(4000, 6000)
    device = random.choice(["SM-G998B", "CPH2269", "V2027", "RMX3085", "M2101K6G"])
    return f"Mozilla/5.0 (Linux; Android {android_vers}; {device}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_vers}.0.{build}.0 Mobile Safari/537.36"

def logo():
    clear()
    print(render('MOHA-02', colors=['white', 'green'], align='center'))
    linex()
    print(f" {Z}({W}★{Z}){W} DEVELOPER : {G}MOHA AL-SHALFAWI (@m_oha_02)")
    print(f" {Z}({W}★{Z}){W} SYSTEM    : {G}TURBO ANTI-BAN")
    print(f" {Z}({W}★{Z}){W} STATUS    : {G}MAX VELOCITY 2026")
    linex()

def add_accounts():
    global accounts
    logo()
    try:
        num = int(input(f" {Z}[{W}?{Z}]{W} HOW MANY ACCOUNTS: {G}"))
        for i in range(num):
            print(f"\n {Y}[~] CONFIGURING ACCOUNT #{i+1}:")
            cookie = input(f" {Z}[{W}?{Z}]{W} ENTER COOKIE: {G}").strip()
            head = {'User-Agent': get_random_ua(), 'Cookie': cookie}
            res = requests.get('https://business.facebook.com/business_locations', headers=head)
            token_match = re.search('(EAAG\w+)', res.text)
            if token_match:
                token = token_match.group(1)
                accounts.append({'token': token, 'cookie': cookie})
                print(f" {G}[✓] ACCOUNT LOADED!")
            else:
                print(f" {Z}[×] FAILED TO EXTRACT TOKEN.")
        time.sleep(1)
    except: pass

def delete_process(data):
    global deleted_count, failed_count, loop
    post_id = data['post_id']
    acc = data['acc']
    color = random.choice(COLOR_LIST)
    
    try:
        # نظام الحذف الموزع مع بصمة جهاز متغيرة
        url = f"https://graph.facebook.com/v18.0/{post_id}"
        headers = {'User-Agent': get_random_ua()}
        res = requests.delete(
            url, 
            params={'access_token': acc['token']}, 
            cookies={'cookie': acc['cookie']}, 
            headers=headers,
            timeout=10
        ).json()
        
        if res.get('success') or res == True:
            deleted_count += 1
        else:
            failed_count += 1
            
        # كسر النمط الزمني (Anti-Spam Delay)
        time.sleep(random.uniform(0.1, 0.4)) 
        
        loop += 1
        sys.stdout.write(f"\r {Z}* {W}({color}TURBO{W}){Z} * {W}LOOP:{loop} {Z}* {G}OK:{deleted_count} {Z}* {Z}CP:{failed_count}{W}")
        sys.stdout.flush()
    except:
        failed_count += 1

def start_turbo_cleaning():
    global accounts, deleted_count, failed_count, loop
    if not accounts:
        print(f" {Z}[!] ADD ACCOUNTS FIRST!"); time.sleep(2); return

    logo()
    group_url = input(f" {Z}[{W}?{Z}]{W} ENTER GROUP LINK/ID: {G}").strip()
    group_id = group_url
    if 'groups/' in group_url:
        group_id = group_url.split('groups/')[1].split('/')[0].split('?')[0]

    print(f"\n {Y}[🚀] ACTIVATING TURBO ANTI-BAN SYSTEM...")
    linex()
    
    try:
        # جلب المنشورات بدفعة كبيرة (100 منشور)
        next_page_url = f"https://graph.facebook.com/v18.0/{group_id}/feed?limit=100&access_token={accounts[0]['token']}"

        while next_page_url:
            res = requests.get(next_page_url, cookies={'cookie': accounts[0]['cookie']}, headers={'User-Agent': get_random_ua()}).json()
            
            if 'data' not in res or not res['data']:
                print(f"\n\n {G}[✓] TARGET CLEANED SUCCESSFULLY.")
                break

            tasks = []
            for i, post in enumerate(res['data']):
                acc = accounts[i % len(accounts)]
                tasks.append({'post_id': post['id'], 'acc': acc})

            # رفع السرعة بـ 25 خيط (Threads) مع حماية التوزيع
            with ThreadPoolExecutor(max_workers=25) as executor:
                executor.map(delete_process, tasks)

            next_page_url = res.get('paging', {}).get('next')
                
    except KeyboardInterrupt:
        print(f"\n\n {Y}[!] EMERGENCY STOP.")
    except Exception as e:
        print(f"\n\n {Z}[!] ERROR: {e}")

    linex()
    print(f" {G}[+] TOTAL SUCCESS: {W}{deleted_count}")
    input(f"\n {G}[*] PRESS ENTER TO MENU")

def main():
    while True:
        logo()
        print(f" {Z}({W}01{Z}){W} > {G}ADD MULTI-ACCOUNTS")
        print(f" {Z}({W}02{Z}){W} > {G}START TURBO CLEANING")
        print(f" {Z}({W}00{Z}){W} > {W}EXIT")
        linex()
        c = input(f" {Z}* {W}SELECT {Z}: {G}")
        if c in ['1', '01']: add_accounts()
        elif c in ['2', '02']: start_turbo_cleaning()
        elif c in ['0', '00']: break

if __name__ == "__main__":
    main()
