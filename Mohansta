import requests, os, sys, time, re, random, hashlib, base64
try:
    from cfonts import render
except ImportError:
    os.system('pip install cfonts')
    from cfonts import render
from concurrent.futures import ThreadPoolExecutor

R = '\033[1;31m'
G = '\033[1;32m'
Y = '\033[1;33m'
B = '\033[1;34m'
W = '\033[1;37m'
P = '\033[1;35m'

accounts = [] 
deleted_count = 0
failed_count = 0

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

def check_access():
    clear()
    _0x2 = "907297e70438f65809804b4433158c8a1491745e45c47796d852a3262071661d"
    print(P + "┌" + "─"*58 + "┐")
    print(render(' LOGIN ', colors=['magenta', 'white'], align='center', font='block'))
    print(P + "└" + "─"*58 + "┘")
    print(f"\033[1;37m [!] ENTER ACCESS KEY TO START")
    print(P + "─"*60)
    _0x3 = input(f"{B} [?] Access Key: {G}")
    if hashlib.sha256(_0x3.encode()).hexdigest() != _0x2:
        print(f"\n{R} [×] ACCESS DENIED")
        sys.exit()
    print(f"\n{G} [✓] SUCCESS")
    time.sleep(1)

def logo():
    clear()
    print(P + "┌" + "─"*58 + "┐")
    print(render(' MOHA ', colors=['magenta', 'cyan'], align='center', font='block'))
    print(P + "└" + "─"*58 + "┘")
    print(f" {B}» {W}Developer : {G}Moha Al-Shalfawi")
    print(f" {B}» {W}System    : {G}Infinite Turbo Cleaner")
    print(f" {B}» {W}Order     : {G}Newest to Oldest")
    print(f" {B}» {W}Status    : {G}Ready to Work")
    print(P + "─"*60)

def add_accounts():
    global accounts
    logo()
    try:
        num = int(input(f"{W} [?] How many accounts to add: {G}"))
        for i in range(num):
            print(f"\n{Y} [~] Setup Account #{i+1}:")
            cookie = input(f"{W} [?] Enter Account Cookies: {G}").strip()
            head = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)', 'Cookie': cookie}
            res = requests.get('https://business.facebook.com/business_locations', headers=head)
            token_match = re.search('(EAAG\w+)', res.text)
            if token_match:
                token = token_match.group(1)
                verify_res = requests.get(f"https://graph.facebook.com/v19.0/me?access_token={token}", cookies={'cookie': cookie}).json()
                if 'id' in verify_res:
                    name = verify_res.get('name', 'Unknown')
                    accounts.append({'token': token, 'cookie': cookie})
                    print(f"{G} [✓] Linked: {W}{name}")
            else:
                print(f"{R} [×] Failed to extract token.")
        time.sleep(2)
    except Exception as e:
        print(f"{R} [!] Error: {e}")

def delete_process(data):
    global deleted_count, failed_count
    try:
        time.sleep(random.uniform(0.3, 0.8))
        url = f"https://graph.facebook.com/v19.0/{data['post_id']}"
        res = requests.delete(url, params={'access_token': data['acc']['token']}, cookies={'cookie': data['acc']['cookie']}).json()
        if res.get('success'):
            deleted_count += 1
            sys.stdout.write(f"\r {W}[+] Deleted Date: {Y}{data['date']} {W}| Total: {G}{deleted_count} {W}")
            sys.stdout.flush()
        else: failed_count += 1
    except: failed_count += 1

def start_turbo_cleaning():
    global accounts, deleted_count, failed_count
    if not accounts:
        print(f"{R} [!] Please add accounts first!"); time.sleep(2); return
    logo()
    group_id = input(f"{W} [?] Group ID or URL: {G}").strip()
    if 'groups/' in group_id:
        group_id = group_id.split('groups/')[1].split('/')[0].split('?')[0]
    
    url = f"https://graph.facebook.com/v19.0/{group_id}/feed?fields=id,created_time&limit=50&access_token={accounts[0]['token']}"
    print(f"\n{P} [🚀] Starting Infinite Cleaning Mode...")
    print(P + "─"*60)
    try:
        while url:
            res = requests.get(url, cookies={'cookie': accounts[0]['cookie']}).json()
            if 'data' not in res or not res['data']: break
            tasks = []
            for i, item in enumerate(res['data']):
                clean_date = item.get('created_time', '').split('T')[0]
                tasks.append({'post_id': item['id'], 'date': clean_date, 'acc': accounts[i % len(accounts)]})
            with ThreadPoolExecutor(max_workers=8) as executor:
                executor.map(delete_process, tasks)
            url = res.get('paging', {}).get('next')
    except KeyboardInterrupt:
        print(f"\n{Y} [!] Stopped.")
    except Exception as e:
        print(f"\n{R} [!] Error: {e}")
    print(f"\n{G} [✓] Done! {deleted_count} Deleted.")
    input(f"{W} Press Enter to back...")

def main():
    check_access()
    while True:
        logo()
        print(f"{W} [1] Add & Verify Accounts\n{W} [2] Start Infinite Turbo Cleaning\n{W} [0] Exit")
        c = input(f"\n{B} [?] Choice: {G}")
        if c == '1': add_accounts()
        elif c == '2': start_turbo_cleaning()
        elif c == '0': break

if __name__ == "__main__":
    main()
