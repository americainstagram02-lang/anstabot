import requests, os, sys, time, re, random, hashlib
from cfonts import render
from concurrent.futures import ThreadPoolExecutor

# Colors
R = '\033[1;31m' # Red
G = '\033[1;32m' # Green
Y = '\033[1;33m' # Yellow
B = '\033[1;34m' # Blue
W = '\033[1;37m' # White
P = '\033[1;35m' # Purple

accounts = [] 
deleted_count = 0
failed_count = 0

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

def check_access():
    """تعديل الخط لتجنب خطأ FileNotFound في ترمكس"""
    clear()
    print(P + "┌" + "─"*58 + "┐")
    # تم تغيير الخط هنا من thin إلى block لحل المشكلة
    print(render(' LOGIN ', colors=['magenta', 'white'], align='center', font='block'))
    print(P + "└" + "─"*58 + "┘")
    
    # الكود: 
    _key_hash = "907297e70438f65809804b4433158c8a1491745e45c47796d852a3262071661d"
    
    user_input = input(f"{W} [?] Enter Access Key: {P}")
    if hashlib.sha256(user_input.encode()).hexdigest() != _key_hash:
        print(f"{R} [×] Incorrect Key!")
        sys.exit()
    print(f"{G} [✓] Access Granted.")
    time.sleep(1)

def logo():
    clear()
    print(P + "┌" + "─"*58 + "┐")
    print(render(' MOHA ', colors=['magenta', 'cyan'], align='center', font='block'))
    print(P + "└" + "─"*58 + "┘")
    print(f" {B}» {W}Developer : {G}Moha Al-Shalfawi")
    print(f" {B}» {W}System    : {G}Infinite Turbo Cleaner")
    print(f" {B}» {W}Status    : {P}Ready to Work")
    print(P + "─"*60)

# بقية الدوال (add_accounts, delete_process, start_turbo_cleaning) تبقى كما هي تماماً دون أي تغيير
def add_accounts():
    global accounts
    logo()
    try:
        num = int(input(f"{W} [?] How many accounts to add: {G}"))
        for i in range(num):
            print(f"\n{Y} [~] Setup Account #{i+1}:")
            cookie = input(f"{W} [?] Enter Account Cookies: {G}").strip()
            head = {'User-Agent': 'Mozilla/5.0', 'Cookie': cookie}
            res = requests.get('https://business.facebook.com/business_locations', headers=head)
            token_match = re.search('(EAAG\w+)', res.text)
            if token_match:
                token = token_match.group(1)
                verify_res = requests.get(f"https://graph.facebook.com/v19.0/me?access_token={token}", cookies={'cookie': cookie}).json()
                if 'id' in verify_res:
                    accounts.append({'token': token, 'cookie': cookie})
                    print(f"{G} [✓] Success: {verify_res.get('name')}")
            else: print(f"{R} [×] Failed.")
        time.sleep(1)
    except Exception as e: print(f"{R} [!] Error: {e}")

def delete_process(data):
    global deleted_count, failed_count
    try:
        time.sleep(random.uniform(0.3, 0.8))
        url = f"https://graph.facebook.com/v19.0/{data['post_id']}"
        res = requests.delete(url, params={'access_token': data['acc']['token']}, cookies={'cookie': data['acc']['cookie']}).json()
        if res.get('success'):
            deleted_count += 1
            sys.stdout.write(f"\r {W}[+] Deleted: {G}{deleted_count}")
            sys.stdout.flush()
    except: failed_count += 1

def start_turbo_cleaning():
    global accounts, deleted_count
    if not accounts: print(f"{R} [!] Add accounts first!"); return
    logo()
    group_id = input(f"{W} [?] Group ID: {G}").strip()
    if 'groups/' in group_id: group_id = group_id.split('groups/')[1].split('/')[0]
    url = f"https://graph.facebook.com/v19.0/{group_id}/feed?limit=50&access_token={accounts[0]['token']}"
    try:
        while url:
            res = requests.get(url, cookies={'cookie': accounts[0]['cookie']}).json()
            if 'data' not in res or not res['data']: break
            tasks = [{'post_id': x['id'], 'acc': accounts[i%len(accounts)], 'date': ''} for i, x in enumerate(res['data'])]
            with ThreadPoolExecutor(max_workers=8) as ex: ex.map(delete_process, tasks)
            url = res.get('paging', {}).get('next')
    except Exception as e: print(f"{R} [!] Error: {e}")
    input(f"\n{G} [✓] Finished. Press Enter...")

def main():
    check_access()
    while True:
        logo()
        print(f"{W} [1] Add Accounts\n{W} [2] Start Cleaning\n{W} [0] Exit")
        c = input(f"\n{B} [?] Choice: {G}")
        if c == '1': add_accounts()
        elif c == '2': start_turbo_cleaning()
        elif c == '0': break

if __name__ == "__main__":
    main()
