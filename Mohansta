import requests, os, sys, time, re
from cfonts import render
from concurrent.futures import ThreadPoolExecutor

# الألوان
Z = '\033[1;31m' # أحمر
G = '\033[1;32m' # أخضر
Y = '\033[1;33m' # أصفر
W = '\033[1;37m' # أبيض

accounts = [] 
deleted_count = 0
failed_count = 0

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

def logo():
    clear()
    print(G + "==========================================================")
    print(Y + render('MOHA-02', colors=['yellow', 'green'], align='center'))
    print(G + "==========================================================")
    print(f"{W} المطور    : {G}موحا الشلفاوي")
    print(f"{W} الحالة    : {G}تنظيف لا نهائي (Infinite Mode)")
    print(f"{W} الترتيب   : {G}من الأحدث إلى الأقدم")
    print(G + "==========================================================")

def add_accounts():
    global accounts
    logo()
    try:
        num = int(input(f"{W} [?] كم حساب تريد إضافته: {G}"))
        for i in range(num):
            print(f"\n{Y} [~] إعداد الحساب رقم {i+1}:")
            cookie = input(f"{W} [?] أدخل كوكيز الحساب: {G}").strip()
            
            head = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)', 'Cookie': cookie}
            res = requests.get('https://business.facebook.com/business_locations', headers=head)
            token_match = re.search('(EAAG\w+)', res.text)
            
            if token_match:
                token = token_match.group(1)
                accounts.append({'token': token, 'cookie': cookie})
                print(f"{G} [✓] تم إضافة الحساب بنجاح!")
            else:
                print(f"{Z} [×] كوكيز غير صالح.")
        time.sleep(1)
    except:
        print(f"{Z} [!] خطأ في الإدخال.")

def delete_process(data):
    global deleted_count, failed_count
    post_id = data['post_id']
    acc = data['acc']
    
    try:
        url = f"https://graph.facebook.com/v17.0/{post_id}"
        res = requests.delete(url, params={'access_token': acc['token']}, 
                             cookies={'cookie': acc['cookie']}, timeout=10).json()
        
        if res.get('success'):
            deleted_count += 1
        else:
            failed_count += 1
            
        sys.stdout.write(f"\r {W}[+] المحذوف: {G}{deleted_count} {W}| {Z}فشل: {failed_count} {W}| نشط: {Y}{len(accounts)}")
        sys.stdout.flush()
    except:
        failed_count += 1

def start_turbo_cleaning():
    global accounts, deleted_count, failed_count
    if not accounts:
        print(f"{Z} [!] يرجى إضافة حسابات أولاً!"); time.sleep(2); return

    logo()
    group_url = input(f"{W} [?] رابط المجموعة: {G}").strip()
    group_id = group_url
    if 'groups/' in group_url:
        group_id = group_url.split('groups/')[1].split('/')[0].split('?')[0]

    # رابط البداية (الأحدث)
    next_page_url = f"https://graph.facebook.com/v17.0/{group_id}/feed?limit=100&access_token={accounts[0]['token']}"

    print(f"\n{Y} [🚀] بدأت عملية التنظيف الشامل... اضغط Ctrl+C للإيقاف")
    
    try:
        while next_page_url:
            # 1. جلب المنشورات
            res = requests.get(next_page_url, cookies={'cookie': accounts[0]['cookie']}).json()
            
            if 'data' not in res or not res['data']:
                print(f"\n{G} [✓] انتهت جميع المنشورات أو تم تنظيف المجموعة بالكامل.")
                break

            current_posts = [p['id'] for p in res['data']]
            
            # 2. توزيع المهام على الحسابات (Round Robin)
            tasks = []
            for i, post_id in enumerate(current_posts):
                acc = accounts[i % len(accounts)]
                tasks.append({'post_id': post_id, 'acc': acc})

            # 3. التنفيذ المتوازي (Turbo)
            with ThreadPoolExecutor(max_workers=15) as executor:
                executor.map(delete_process, tasks)

            # 4. الانتقال للصفحة التالية (الأقدم)
            if 'paging' in res and 'next' in res['paging']:
                next_page_url = res['paging']['next']
            else:
                next_page_url = None
                
    except KeyboardInterrupt:
        print(f"\n{Y} [!] تم إيقاف العملية بواسطة المستخدم.")
    except Exception as e:
        print(f"\n{Z} [!] حدث خطأ: {e}")

    print(f"\n{G} [✓] إجمالي ما تم حذفه: {deleted_count}")
    input(f"{W} اضغط Enter للعودة...")

def main():
    while True:
        logo()
        print(f"{W} [1] إضافة حسابات (متعدد)")
        print(f"{W} [2] بدء الحذف اللانهائي (من الأحدث للأقدم)")
        print(f"{W} [0] خروج")
        c = input(f"\n{W} [?] الخيار: {G}")
        if c == '1': add_accounts()
        elif c == '2': start_turbo_cleaning()
        elif c == '0': break

if __name__ == "__main__":
    main()
